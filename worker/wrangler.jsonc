/**
 * Geckodupe Spam Worker
 * Deploy: npx wrangler deploy (from this directory)
 *
 * Bindings are filled after `wrangler kv namespace create` / rate-limit setup.
 * Until then, local `wrangler dev` works with remote:false simulation.
 */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "geckodupe-spam",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "GECKODUPE_SPAM",
      "id": "d7f1cf328aa2499a9f052a2e0b0112b5",
      "preview_id": "f1ac4d944ef64548b8b11d6652dfecd1"
    }
  ],
  "ratelimits": [
    {
      "name": "SPAM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
