{
  "name": "@flareform/geckodupe",
  "version": "1.0.1",
  "description": "Geckodupe by Flareform - heuristic deduplication and anti-spam engine for text, files, folders, and media. 100% browser-based.",
  "homepage": "https://gekodupe.github.io/Gekodupe/",
  "private": false,
  "files": [
    "css/",
    "js/",
    "public/",
    "text-file/",
    "folder-zip/",
    "image-video/",
    ".well-known/",
    "index.html",
    "404.html",
    "robots.txt",
    "sitemap.xml",
    "site.webmanifest",
    "_headers",
    "humans.txt",
    "LICENSE",
    "README.md",
    "site.config.json",
    "scripts/build.js",
    "scripts/serve.js",
    "scripts/site-meta.js",
    "scripts/security-policy.js"
  ],
  "scripts": {
    "test": "vitest run --config ../../.development/geckodupe/vitest.config.js",
    "test:watch": "vitest --config ../../.development/geckodupe/vitest.config.js",
    "test:folder": "node ../../.development/geckodupe/scripts/test-folder.js",
    "test:media": "node ../../.development/geckodupe/scripts/test-media.js",
    "test:benchmark": "node ../../.development/geckodupe/scripts/run-benchmark.js",
    "test:e2e": "playwright test --config ../../.development/geckodupe/playwright.config.js",
    "test:all": "npm run test && npm run test:folder && npm run test:media && npm run test:benchmark && npm run test:e2e",
    "test:audit": "vitest run --config ../../.development/geckodupe/vitest.config.js ../../.development/geckodupe/tests/audit.test.js && playwright test --config ../../.development/geckodupe/playwright.config.js ../../.development/geckodupe/tests/e2e/audit.spec.js",
    "lighthouse": "node ../../.development/geckodupe/scripts/run-lighthouse.js",
    "build": "node scripts/build.js",
    "site-meta": "node scripts/site-meta.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.25.0",
    "lighthouse": "^13.4.0",
    "vitest": "^3.0.9"
  }
}
